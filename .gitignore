# ================================
# PYTHON & RUNTIME
# ================================
# Python cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.env/
.venv/
.venv-docs/
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment variables
.env
.envrc

# ================================
# SECURITY - CREDENTIALS & SECRETS
# ================================
# Google Cloud credentials - SECURITY CRITICAL
*.json
key.json
service-account*.json
credentials.json
# Streamlit secrets
.streamlit/secrets.toml
.streamlit/config.toml

# Explicitly allow important JSON files
!package.json
!package-lock.json
!pyproject.toml
!data/inspections.json
!data/storage_config.json
!tests/fixtures/**/*.json

# ================================
# BUILD & DISTRIBUTION
# ================================
# Poetry and packaging
dist/
build/
*.egg-info/

# MkDocs generated site
site/

# ================================
# DEVELOPMENT & TOOLS
# ================================
# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Streamlit configuration
.streamlit/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ================================
# DATA & USER CONTENT
# ================================
# User uploads and temporary data
data/uploads/
data/exports/*.csv
data/exports/*.json
upload_*

# Generated app files
hive_color_log.csv
hive_color_log.json
*.sqlite
*.db

# Logs and monitoring
logs/
*.log

# ================================
# TEMPORARY & CACHE FILES
# ================================
# Temporary files
temp_*
tmp/
*.tmp
*.cache
.cache/
*.pid

# System files
.DS_Store
.DS_Store?
**/.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ================================
# MEDIA FILES
# ================================
# Image files (exclude by default, include selectively)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.heic
*.webp

# Explicitly include important images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg
!src/default_beepic.jpg
!assets/**/*.png
!assets/**/*.jpg

# ================================
# DEVELOPMENT ARTIFACTS
# ================================
# Draft and experimental code
drafts/
src/app_draft.py
experimental/
